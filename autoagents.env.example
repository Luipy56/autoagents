# autoagents.env.example
# Copy to agents/autoagents.env in the host project and fill in.
# Do not commit secrets. agent-loop.sh sources autoagents.env automatically.

# --- Identity ---
# GitHub owner/repo for issues (required for agent 001)
AGENT_GH_REPO=owner/repo

# Integration / production branches (prompts + committer)
AGENT_INTEGRATION_BRANCH=development
AGENT_PRODUCTION_BRANCH=master

# Application source trees (space-separated, relative to repo root)
APP_CODE_DIRS="back/ front/"

# Docker containers for 001 log heuristics (space-separated). Empty = skip log pass.
AGENT_DOCKER_CONTAINERS="app-front app-back app-db"

# --- Optional roles ---
# Satellite / marketing repos reviewer (005). Set 0 if this project has none.
AGENT_ENABLE_005=0
# Enhancement / weekly health reviewer (008)
AGENT_ENABLE_008=1

# --- Loop tuning (optional) ---
# AGENT_LOOP_SLEEP_MINUTES=5
# AGENT_GIT_SYNC=1
# AGENT_TESTER_TIMEOUT_MINUTES=32
# AGENT_CURSOR_TIMEOUT_MINUTES=25
