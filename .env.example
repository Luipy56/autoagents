# Copy to .env. Default: Ollama on this machine (no SSH).
OLLAMA_API_BASE=http://127.0.0.1:11434
JARVYS_OLLAMA_MODEL=qwen3:latest

# Set to 1 only if you use SSH port-forwarding to a remote Ollama (see docs/jarvys-network.md).
JARVYS_AUTO_SSH_TUNNEL=0

# --- Optional: SSH tunnel (uncomment and fill when JARVYS_AUTO_SSH_TUNNEL=1) ---
# JARVYS_TUNNEL_STYLE=amvara8_local
# JARVYS_SSH_TUNNEL_HOST=178.63.8.217
# JARVYS_SSH_TUNNEL_PORT=60022
# JARVYS_SSH_TUNNEL_USER=yoel
# JARVYS_SSH_LOCAL_PORT=11434
# JARVYS_SSH_PROXYJUMP=amvara4
#
# JARVYS_TUNNEL_STYLE=amvara4_forward
# JARVYS_SSH_BASTION_HOST=162.55.45.216
# JARVYS_SSH_BASTION_PORT=60022
# JARVYS_SSH_BASTION_USER=root
# JARVYS_OLLAMA_REMOTE_HOST=10.x.x.x
