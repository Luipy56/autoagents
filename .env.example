# Copy to .env at the application repo root and/or under jarvys-team/ (see README).
# Runtime loads .env only, not this file. Later file wins: parent .env first, then jarvys-team/.env.

# Ollama HTTP API root (no path suffix). Jarvys calls /api/tags and /api/generate.
# OLLAMA_API_BASE=http://127.0.0.1:11434
# JARVYS_OLLAMA_MODEL=model

# Git integration branch for fetch/pull (default: agentdevelop). Example for standalone repos:
# AGENT_GIT_BRANCH=main

# Optional: application git root if the bundle folder is not named jarvys-team or lives elsewhere.
# JARVYS_REPO_ROOT=/path/to/your/app

# Optional: folder name that triggers "nested" mode (parent directory = app root). Default: jarvys-team
# JARVYS_BUNDLE_DIRNAME=jarvys-team

# Skip the fast GET /api/tags check at startup (e.g. offline). Default: 0
# JARVYS_SKIP_OLLAMA_GATE=0

