# Copy to .env at the application repo root and/or under jarvys-team/ (see README).
# Later file wins when both exist: parent .env first, then jarvys-team/.env.

# Ollama HTTP API root (no path suffix). Jarvys calls /api/tags and /api/generate.
OLLAMA_API_BASE=http://127.0.0.1:11434
JARVYS_OLLAMA_MODEL=qwen3:latest

# Optional: application git root if the bundle folder is not named jarvys-team or lives elsewhere.
# JARVYS_REPO_ROOT=/path/to/your/app

# Optional: folder name that triggers "nested" mode (parent directory = app root). Default: jarvys-team
# JARVYS_BUNDLE_DIRNAME=jarvys-team

# Skip the fast GET /api/tags check at startup (e.g. offline). Default: 0
# JARVYS_SKIP_OLLAMA_GATE=0

# Set to 1 only if you use SSH port-forwarding to a remote Ollama (see docs/jarvys-network.md).
JARVYS_AUTO_SSH_TUNNEL=0

# --- Optional: SSH tunnel (all host/user/port values required; no defaults in code) ---
# JARVYS_TUNNEL_STYLE=amvara8_local
# JARVYS_SSH_TUNNEL_HOST=your-ollama-host.example
# JARVYS_SSH_TUNNEL_PORT=22
# JARVYS_SSH_TUNNEL_USER=deploy
# JARVYS_SSH_LOCAL_PORT=11434
# JARVYS_SSH_PROXYJUMP=your-jump-host-alias
#
# JARVYS_TUNNEL_STYLE=amvara4_forward
# JARVYS_SSH_BASTION_HOST=bastion.example
# JARVYS_SSH_BASTION_PORT=22
# JARVYS_SSH_BASTION_USER=deploy
# JARVYS_OLLAMA_REMOTE_HOST=10.x.x.x
